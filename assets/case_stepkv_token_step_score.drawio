        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Case: Dynamic Token + Step Scores&lt;/b&gt;&lt;br&gt;Guggenheim Bilbao — success · not find · novelty · repeat · citation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1200" height="50" as="geometry" />
        </mxCell>

        <!-- Question -->
        <mxCell id="qbox" value="&lt;b&gt;Question:&lt;/b&gt; In what year did the Guggenheim Museum Bilbao, designed by Frank Gehry, open?&lt;br&gt;&lt;b&gt;Gold answer:&lt;/b&gt; 1997" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="1440" height="50" as="geometry" />
        </mxCell>

        <!-- Formula inset -->
        <mxCell id="formula" value="&lt;b&gt;Step score (external)&lt;/b&gt;&lt;br&gt;reward = success + novelty − 0.3×repeat&lt;br&gt;step_score = 0.85·reward + 0.15·log(1+citation)&lt;br&gt;combined(token) = α·token_HH + β·step_score[owner_step]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="80" y="145" width="420" height="75" as="geometry" />
        </mxCell>

